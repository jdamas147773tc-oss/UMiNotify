rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == 'student'
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.studentId is string
        && request.resource.data.studentId.size() > 0
        && request.resource.data.department in ['DCE', 'DASE', 'DEE']
        && (
          (request.resource.data.department == 'DCE'
            && request.resource.data.program in ['IT', 'CS'])
          || (request.resource.data.department == 'DASE'
            && request.resource.data.program in ['Psychology', 'AB English'])
          || (request.resource.data.department == 'DEE'
            && request.resource.data.program in ['Electrical Engineering', 'Computer Engineering'])
        )
        && request.resource.data.email == request.auth.token.email;
      allow update, delete: if false;
    }
  }
}
